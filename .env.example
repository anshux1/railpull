# Optional environment configuration for crawler-manager and ntes/crawl.py.
# Values below are the safe defaults; do not reduce the request pause for a
# public NTES service.

RAILPULL_PYTHON=/absolute/path/to/railpull/.venv/bin/python
RAILPULL_PAUSE=1.2
RAILPULL_JITTER=0.4
RAILPULL_WORKERS=4
RAILPULL_CONNECT_TIMEOUT=10
RAILPULL_READ_TIMEOUT=30
RAILPULL_ATTEMPTS=4
RAILPULL_CHECKPOINT_EVERY=25
RAILPULL_CHECKPOINT_SECONDS=30
RAILPULL_HEARTBEAT_SECONDS=15
RAILPULL_MAX_NETWORK_FAILURES=12

# Manager/watchdog settings.
RAILPULL_HEALTH_INTERVAL=15
RAILPULL_HANG_TIMEOUT=900
RAILPULL_RESTART_DELAY=10
RAILPULL_MAX_RESTART_DELAY=3600
RAILPULL_MAX_RESTARTS=0
RAILPULL_STOP_TIMEOUT=45
RAILPULL_LOG_MAX_BYTES=52428800
RAILPULL_LOG_BACKUPS=5

# Optional extra crawler arguments, parsed with shell-like quoting.
# RAILPULL_CRAWL_ARGS=--stage schedules --seed /path/to/roster.json
